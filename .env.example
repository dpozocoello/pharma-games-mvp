# Copia este archivo a .env para desarrollo local. NUNCA pongas valores reales aquí.
NODE_ENV=development

# Infraestructura local (docker-compose)
POSTGRES_USER=pharma
POSTGRES_PASSWORD=pharma_dev_only
POSTGRES_DB=pharma
POSTGRES_PORT=55432
REDIS_PORT=6379

# API
API_PORT=3000
DATABASE_URL=postgresql://pharma:pharma_dev_only@localhost:55432/pharma?schema=public
REDIS_URL=redis://localhost:6379
# Orígenes permitidos por CORS, separados por comas
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Secreto HMAC para hashear documentos de identidad (mínimo 32 caracteres en producción)
DOCUMENT_HASH_SECRET=dev-only-document-hash-secret-change-me
# Secreto HMAC para firmar tokens de partida
SESSION_TOKEN_SECRET=dev-only-session-token-secret-change-me
# Secreto para firmar tokens de acceso (JWT) y hashear códigos OTP
AUTH_TOKEN_SECRET=dev-only-auth-token-secret-change-me
# Cookie de refresh solo por HTTPS (en producción siempre true)
COOKIE_SECURE=false
# Detrás de un balanceador, número de proxies de confianza (para la IP real)
TRUST_PROXY_HOPS=0

# Mensajería OTP: console (desarrollo, sin envíos reales) o whatsapp (con respaldo SMS)
MESSAGING_PROVIDER=console
# WHATSAPP_API_URL=https://graph.facebook.com/v21.0
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE=otp_code
# SMS_API_URL=
# SMS_API_TOKEN=
LOG_LEVEL=info

# Ranking en vivo (ADR-023): intervalo mínimo entre reconstrucciones y edad máxima, en ms
# RANKING_LIVE_MIN_REBUILD_MS=10000
# RANKING_LIVE_MAX_AGE_MS=300000
# Foto oficial diaria (ADR-024): hora local de cada país (cron de 5 campos) y worker en este proceso
# RANKING_SNAPSHOT_CRON=55 23 * * *
# JOBS_WORKER_ENABLED=true
