{
  "name": "pharma-games",
  "private": true,
  "description": "Plataforma de juegos de capacitación farmacéutica (MVP)",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "infra:up": "docker compose -f infra/docker-compose.yml --env-file .env up -d --wait",
    "infra:down": "docker compose -f infra/docker-compose.yml --env-file .env down",
    "db:migrate": "pnpm --filter @pharma/api db:migrate",
    "db:seed": "pnpm --filter @pharma/api db:seed",
    "db:reset": "pnpm --filter @pharma/api db:reset",
    "predev": "pnpm infra:up && pnpm --filter @pharma/shared build && pnpm db:migrate",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:int": "turbo run test:int",
    "size": "node scripts/check-bundle-size.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.1"
  },
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "^8.0.2",
      "effect": "^3.22.1"
    }
  },
  "scarfSettings": {
    "enabled": false
  }
}
