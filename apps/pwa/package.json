{
  "name": "@pharma/pwa",
  "version": "0.1.0",
  "private": true,
  "description": "PWA del dependiente y del gerente de farmacia",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@pharma/game-sdk": "workspace:*",
    "@pharma/game-trivia": "workspace:*",
    "@pharma/game-true-false": "workspace:*",
    "@pharma/shared": "workspace:*",
    "@tanstack/react-query": "^5.62.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "^2.1.8",
    "workbox-window": "7.4.1"
  }
}
